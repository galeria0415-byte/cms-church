generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
  STAFF
  VIEWER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum CivilStatus {
  SINGLE
  MARRIED
  WIDOWED
  DIVORCED
  SEPARATED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  VISITOR
  TRANSFERRED
  DECEASED
}

enum MembershipType {
  BAPTISM
  CONFIRMATION
  TRANSFER
  RESTORATION
}

enum ServiceAttendanceStatus {
  REGULAR
  OCCASIONAL
  ONLINE_ONLY
  INACTIVE
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  passwordHash  String
  role          UserRole      @default(VIEWER)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  events        Event[]       @relation("EventAuthor")
  programs      Program[]     @relation("ProgramAuthor")
  galleries     Gallery[]     @relation("GalleryAuthor")
  activityLogs  ActivityLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Member {
  id                       String                  @id @default(cuid())
  memberId                 String                  @unique
  firstName                String
  middleName               String?
  lastName                 String
  suffix                   String?
  gender                   Gender?
  birthDate                DateTime?
  civilStatus              CivilStatus?
  nationality              String?
  contactNumber            String?
  email                    String?
  address                  String?
  profilePhotoUrl          String?
  emergencyContactName     String?
  emergencyContactNumber   String?
  spouseName               String?
  weddingDate              DateTime?
  fatherName               String?
  fatherMemberId           String?
  fatherDeceasedDate       DateTime?
  fatherBirthDate          DateTime?
  motherName               String?
  motherMemberId           String?
  motherDeceasedDate       DateTime?
  motherBirthDate          DateTime?
  childrenLinks            String?                  @db.Text
  guardian                 String?
  deceasedDate             DateTime?
  highestEducation         String?
  schoolAttended           String?
  courseOrDegree           String?
  occupation               String?
  companyName              String?
  employmentStatus         String?
  workAddress              String?
  dateJoinedChurch         DateTime?
  membershipStatus         MembershipStatus        @default(ACTIVE)
  membershipType           MembershipType          @default(BAPTISM)
  baptizedDate             DateTime?
  previousChurch           String?
  churchOrganization       String?
  membershipCategory       String?
  shepherdingGroup         String?
  confirmationDate         DateTime?
  serviceAttendanceStatus  ServiceAttendanceStatus @default(REGULAR)
  ministryRoles            String?                  @db.Text
  trainingCompleted        String?                  @db.Text
  notes                    String?
  remarks                  String?
  recordStatus             RecordStatus            @default(ACTIVE)
  isArchived               Boolean                 @default(false)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([lastName, firstName])
  @@index([membershipStatus])
  @@index([recordStatus])
  @@index([birthDate])
  @@index([weddingDate])
  @@index([deceasedDate])
  @@index([shepherdingGroup])
}

model Post {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String?
  content       String        @db.Text
  featuredImage String?
  authorId      String
  publishDate   DateTime?
  status        ContentStatus @default(DRAFT)
  isFeatured    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  author        User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([status, publishDate])
}

model Event {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String   @db.Text
  eventDate        DateTime
  time             String?
  location         String?
  bannerImage      String?
  registrationLink String?
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        User     @relation("EventAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([eventDate])
}

model Gallery {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String?
  coverImage  String?
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   User           @relation("GalleryAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  images      GalleryImage[]
}

model GalleryImage {
  id        String   @id @default(cuid())
  galleryId String
  imageUrl  String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  gallery   Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId, sortOrder])
}

model Program {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  scheduleDay   String
  scheduleTime  String
  location      String?
  description   String?  @db.Text
  isActive      Boolean  @default(true)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     User     @relation("ProgramAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([isActive, scheduleDay])
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  summary    String
  userId     String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Slide {
  id        String   @id @default(cuid())
  title     String?
  caption   String?
  mediaUrl  String
  mediaType String   @default("image")
  linkUrl   String?
  linkLabel String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}
